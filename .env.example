# IMPORTANT: This file is for reference only.
# SportSphere uses --dart-define compile-time constants, NOT a bundled .env file.
#
# DO NOT add .env or .env.example back to pubspec.yaml assets — doing so
# embeds secrets in the APK binary in plaintext.
#
# Pass secrets at build/run time:
#   flutter run \
#     --dart-define=SUPABASE_URL=https://your-project.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=your-anon-jwt-here
#
# See .vscode/launch.json.example for a VS Code launch configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt-here
