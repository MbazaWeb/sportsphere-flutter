# Playify VPS — Environment Variables
# Copy to /var/playify/api/.env and fill in

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://playify:CHANGE_ME@localhost:5432/playify
DIRECT_URL=postgresql://playify:CHANGE_ME@localhost:5432/playify

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://playifysport.fun,https://admin.playifysport.fun

# ── MinIO (S3-compatible) ──────────────────────────────────────────────────────
STORAGE_DRIVER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=playify
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_COVERS=covers
MINIO_BUCKET_POSTS=posts
MINIO_BUCKET_MEDIA=media
# NOTE: nginx strips /storage/ and proxies to MinIO root — the bucket must be
# part of the CDN base URL, otherwise every media URL 404s.
CDN_BASE_URL=https://playifysport.fun/storage/media

# ── Soketi (Pusher-compatible realtime) ────────────────────────────────────────
SOKETI_HOST=localhost
SOKETI_PORT=6001
# Must match /etc/playify/soketi.json (written by vps/setup.sh)
SOKETI_APP_ID=playify-app
SOKETI_APP_KEY=CHANGE_ME
# Code reads SOKETI_SECRET (not SOKETI_APP_SECRET)
SOKETI_SECRET=CHANGE_ME

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_EXPIRES_IN=15m
REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX
REFRESH_EXPIRES_IN=30d

# ── Firebase (FCM push) ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://playifysport.fun/v1/mpesa/callback
MPESA_CALLBACK_HOST=playifysport.fun
MPESA_CALLBACK_TOKEN=

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Sports Data Providers (used by the AI Director + admin Data Fetch page) ────
# football-data.org — free tier (fixtures, standings, scorers for PL/CL/SA/BL1/FL1/PD/...)
# Get a token at https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# RapidAPI key — used for multiple endpoints (apifootball3 for Tanzania Ligi Kuu Bara,
# football-prediction-api for predictions, latest-football-news for news, etc.)
RAPIDAPI_KEY=
