# Playify VPS — Environment Variables
# Copy to /var/playify/api/.env and fill in

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://playify:CHANGE_ME@localhost:5432/playify
DIRECT_URL=postgresql://playify:CHANGE_ME@localhost:5432/playify

# ── Supabase (keep during migration period) ────────────────────────────────────
SUPABASE_URL=https://fffqjbrethogesgghjsn.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://app.playify.app,https://admin.playify.app

# ── MinIO (S3-compatible) ──────────────────────────────────────────────────────
STORAGE_DRIVER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=playify
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_COVERS=covers
MINIO_BUCKET_POSTS=posts
MINIO_BUCKET_MEDIA=media
CDN_BASE_URL=https://api.playify.app/storage

# ── Soketi (Pusher-compatible realtime) ────────────────────────────────────────
SOKETI_HOST=localhost
SOKETI_PORT=6001
SOKETI_APP_ID=playify
SOKETI_APP_KEY=CHANGE_ME
SOKETI_APP_SECRET=CHANGE_ME

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_EXPIRES_IN=15m
REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX
REFRESH_EXPIRES_IN=30d

# ── Firebase (FCM push) ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.playify.app/api/mpesa/callback
MPESA_CALLBACK_HOST=api.playify.app
MPESA_CALLBACK_TOKEN=

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
